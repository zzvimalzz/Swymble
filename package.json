{
  "name": "swymble",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"main,mybirth,what2watch\" -c \"cyan,green,yellow\" \"vite\" \"npm --prefix src/data/subdomains/mybirth run dev\" \"npm --prefix src/data/subdomains/what2watch run dev\"",
    "dev:main": "vite",
    "dev:mybirth": "concurrently --names \"main,mybirth\" -c \"cyan,green\" \"vite\" \"npm --prefix src/data/subdomains/mybirth run dev\"",
    "dev:what2watch": "concurrently --names \"main,what2watch\" -c \"cyan,yellow\" \"vite\" \"npm --prefix src/data/subdomains/what2watch run dev\"",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:feed": "node scripts/generate-feed.mjs",
    "generate:indexnow-key": "node scripts/generate-indexnow-key.mjs",
    "generate:seo": "npm run generate:sitemap && npm run generate:robots && npm run generate:llms && npm run generate:feed && npm run generate:indexnow-key",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "generate:markdown": "node scripts/generate-markdown.mjs",
    "generate:site-data": "node scripts/generate-site-data.mjs",
    "generate:mcp-card": "node scripts/generate-mcp-card.mjs",
    "generate:og-cards": "node scripts/generate-og-cards.mjs",
    "generate:mybirth-icons": "node scripts/generate-mybirth-icons.mjs",
    "generate:agent-files": "npm run generate:markdown && npm run generate:site-data && npm run generate:mcp-card",
    "build:main": "npm run generate:seo && tsc -b && vite build && npm run generate:og-cards && node scripts/prerender-meta.mjs && node scripts/prerender-snapshot.mjs && npm run generate:agent-files",
    "build:mybirth": "npm --prefix src/data/subdomains/mybirth run build",
    "build:what2watch": "npm --prefix src/data/subdomains/what2watch run build",
    "build": "npm run build:main && npm run build:mybirth && npm run build:what2watch",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^10.0.3",
    "puppeteer": "^25.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  }
}
