# Optional: override the contact-form API endpoint.
# Defaults to https://swymble.com/api/contact (the Cloudflare contact-worker).
VITE_CONTACT_ENDPOINT=https://swymble.com/api/contact

# --- Search visibility (build-time only; all optional, all public values) --------------------
# These are read by the build, not by the browser bundle, so they are deliberately not VITE_*.
# In CI they come from GitHub Actions repository *variables* — none of them is a secret.
# See docs/search-visibility.md for where to get each one.

# Google Search Console ownership token — the `content` value of the meta tag Google offers under
# "HTML tag" verification. Injects <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership token. Injects <meta name="msvalidate.01">.
BING_SITE_VERIFICATION=

# IndexNow key: 8-128 characters, letters/digits/dashes. Generate one with
#   node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
# The build publishes it at /<key>.txt and the deploy pings Bing with the sitemap's URLs.
INDEXNOW_KEY=

# --- Agent discovery (build-time only) -------------------------------------------------------
# The deployed MCP server's endpoint, e.g. https://swymble-mcp.<subdomain>.workers.dev/mcp.
# Set this only AFTER deploying cloudflare/mcp-worker.js — the build publishes
# /.well-known/mcp/server-card.json pointing at it, and a card advertising an endpoint that does
# not exist is worse than no card. Must be https. See docs/agent-readiness.md.
MCP_SERVER_URL=
